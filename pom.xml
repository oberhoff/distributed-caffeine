<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.oberhoff.distributed-caffeine</groupId>
    <artifactId>distributed-caffeine</artifactId>
    <version>0.8.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Distributed Caffeine</name>

    <description>Distributed Caffeine adds distribution and a shared second level to Caffeine, through a store
        the application may already use: MongoDB, PostgreSQL, Redis (also Valkey, Dragonfly, Kvrocks), MariaDB or MySQL.
    </description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <caffeine.sources>${project.build.directory}/caffeine-sources</caffeine.sources>
        <caffeine.version>3.3.1</caffeine.version>
        <hash4j.version>0.31.0</hash4j.version>
        <fory.version>1.7.7</fory.version>
        <jspecify.version>1.0.1</jspecify.version>
        <mongodb.version>5.14.0</mongodb.version>
        <postgresql.version>42.7.14</postgresql.version>
        <lettuce.version>7.9.0.RELEASE</lettuce.version>
        <jedis.version>8.0.2</jedis.version>
        <redisson.version>4.8.0</redisson.version>
        <jackson.version>3.2.4</jackson.version>
        <checkerqual.version>4.4.0</checkerqual.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <hikaricp.version>7.1.0</hikaricp.version>
        <mariadb.version>3.5.11</mariadb.version>
        <mysql.version>26.10.0</mysql.version>
        <lincheck.version>3.7</lincheck.version>
        <jmh.version>1.37</jmh.version>
        <slf4j.version>2.0.20</slf4j.version>
    </properties>

    <url>https://github.com/oberhoff/distributed-caffeine</url>

    <developers>
        <developer>
            <name>Andreas Oberhoff</name>
            <email>github@oberhoff.net</email>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/oberhoff/distributed-caffeine.git</connection>
        <developerConnection>scm:git:https://github.com/oberhoff/distributed-caffeine.git</developerConnection>
        <url>https://github.com/oberhoff/distributed-caffeine/tree/main</url>
    </scm>

    <issueManagement>
        <url>https://github.com/oberhoff/distributed-caffeine/issues</url>
    </issueManagement>

    <dependencyManagement>
        <dependencies>
            <!-- Jedis (optional) brings slf4j-api 1.7, which would win over the tests' SLF4J 2 bridge and break it
                 (NoSuchMethodError on Logger.isEnabledForLevel); SLF4J 2's API serves Jedis's 1.7 calls. Only this
                 build: a user's own build resolves its own version -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dynatrace.hash4j</groupId>
            <artifactId>hash4j</artifactId>
            <version>${hash4j.version}</version>
        </dependency>
        <!-- the default serializer, so a cache runs with no configuration (VISION.md, Serialization) -->
        <dependency>
            <groupId>org.apache.fory</groupId>
            <artifactId>fory-core</artifactId>
            <version>${fory.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>${mongodb.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <version>${lettuce.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- The PostgreSQL driver's class files reference these annotations, which javac reads when compiling
             against it, while the driver itself declares them at runtime scope only - so they are absent exactly
             where they are needed and a warning about it fails the build. Provided, so nothing of it reaches a
             user of this library, and at any version that still has them, since the driver's class files only name
             them - so it is kept current like every other dependency rather than at the driver's version. -->
        <dependency>
            <groupId>org.checkerframework</groupId>
            <artifactId>checker-qual</artifactId>
            <version>${checkerqual.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mongodb</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- the plain JDBC adapter's database in the tests: MariaDB in a container -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>${mariadb.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mariadb</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- linearizability of the operations under concurrency: stress runs and model checking -->
        <dependency>
            <groupId>org.jetbrains.lincheck</groupId>
            <artifactId>lincheck</artifactId>
            <version>${lincheck.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk-platform-logging</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- prints what the library and Testcontainers log (src/test/resources/simplelogger.properties) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <executions>
                    <!-- JMH generates its benchmark classes with an annotation processor, which compilers since
                         JDK 23 only run when asked to -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>${jmh.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <!-- a plain class path, so that forked JMH benchmark JVMs find the test classes -->
                    <useManifestOnlyJar>false</useManifestOnlyJar>
                    <!-- JaCoCo's agent (@{argLine}); Lincheck attaches its agent at run time: within the JVM, quietly
                         (JEP 451) -->
                    <argLine>@{argLine} -XX:MaxRAMPercentage=50 -Djdk.attach.allowAttachSelf=true -XX:+EnableDynamicAgentLoading</argLine>
                    <!-- a JVM per test class: Lincheck's instrumentation has crashed the JVM (Temurin 25.0.1, SIGBUS
                         in RedefineClasses), and in a shared fork every class after it went unrun -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.github.oberhoff.distributedcaffeine</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <!-- Caffeine's sources for the Javadoc tool, which copies Caffeine's text into {@inheritDoc}
                         only from its sources, not from its classes -->
                    <execution>
                        <id>unpack-caffeine-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.github.ben-manes.caffeine</groupId>
                                    <artifactId>caffeine</artifactId>
                                    <version>${caffeine.version}</version>
                                    <classifier>sources</classifier>
                                    <outputDirectory>${caffeine.sources}</outputDirectory>
                                    <!-- its module descriptor would make the documented sources a named module -->
                                    <excludes>module-info.java</excludes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <!-- Caffeine's sources are read for {@inheritDoc}, not documented; its own Javadoc is linked -->
                    <sourcepath>${project.build.sourceDirectory}${path.separator}${caffeine.sources}</sourcepath>
                    <excludePackageNames>com.github.benmanes.caffeine:com.github.benmanes.caffeine.*</excludePackageNames>
                    <links>
                        <link>https://javadoc.io/doc/com.github.ben-manes.caffeine/caffeine/${caffeine.version}/</link>
                    </links>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>enforce-maven-version</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>3.7.0</version>
                                </requireMavenVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>generate-report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>5.1.2</version>
                <executions>
                    <execution>
                        <id>format-license</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>format</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <properties>
                        <owner>Dr. Andreas Oberhoff</owner>
                        <year>2023-2026</year>
                        <email>All rights reserved</email>
                    </properties>
                    <licenseSets>
                        <licenseSet>
                            <header>com/mycila/maven/plugin/license/templates/APACHE-2.txt</header>
                            <useDefaultExcludes>true</useDefaultExcludes>
                            <excludes>
                                <exclude>**/*.txt</exclude>
                                <exclude>**/*.xml</exclude>
                                <exclude>**/*.yml</exclude>
                                <exclude>**/*.yaml</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.12.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>false</autoPublish>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>errorprone</id>
            <activation>
                <property>
                    <name>!skipErrorProne</name>
                </property>
            </activation>
            <properties>
                <errorprone.args>${nullaway.args} ${errorprone.checks}</errorprone.args>
                <errorprone.testargs>${nullaway.testargs} ${errorprone.checks} ${errorprone.generated}</errorprone.testargs>
                <!-- JMH's generated benchmark classes are not ours to fix -->
                <errorprone.generated>-XepExcludedPaths:.*/generated-test-sources/.*</errorprone.generated>
                <errorprone.checks>${errorprone.nullness} ${errorprone.hygiene}</errorprone.checks>
                <errorprone.nullness>-Xep:EqualsMissingNullable:ERROR</errorprone.nullness>
                <errorprone.hygiene>${errorprone.catching} ${errorprone.utility}</errorprone.hygiene>
                <errorprone.catching>-Xep:CatchingUnchecked:ERROR</errorprone.catching>
                <errorprone.utility>-Xep:PrivateConstructorForUtilityClass:ERROR</errorprone.utility>
                <nullaway.args>${nullaway.severity} ${nullaway.mode} ${nullaway.checks}</nullaway.args>
                <!-- NullAway is scoped to the main sources, as test code deliberately passes and dereferences
                     nulls to exercise rejection paths. Its options have to stay set even with the check switched
                     off, because Error Prone instantiates every plugin regardless of severity. -->
                <nullaway.testargs>-Xep:NullAway:OFF ${nullaway.mode}</nullaway.testargs>
                <nullaway.severity>-Xep:NullAway:ERROR</nullaway.severity>
                <nullaway.mode>-XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true</nullaway.mode>
                <nullaway.checks>${nullaway.optional} ${nullaway.flow} ${nullaway.overrides}</nullaway.checks>
                <nullaway.optional>-XepOpt:NullAway:CheckOptionalEmptiness=true</nullaway.optional>
                <nullaway.flow>${nullaway.contracts} ${nullaway.asserts}</nullaway.flow>
                <nullaway.contracts>-XepOpt:NullAway:CheckContracts=true</nullaway.contracts>
                <nullaway.asserts>-XepOpt:NullAway:AssertsEnabled=true</nullaway.asserts>
                <nullaway.overrides>${nullaway.restrictive} ${nullaway.exhaustive}</nullaway.overrides>
                <nullaway.restrictive>-XepOpt:NullAway:AcknowledgeRestrictiveAnnotations=true</nullaway.restrictive>
                <nullaway.exhaustive>-XepOpt:NullAway:ExhaustiveOverride=true</nullaway.exhaustive>
                <j.api>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</j.api>
                <j.file>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</j.file>
                <j.main>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</j.main>
                <j.model>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</j.model>
                <j.parser>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</j.parser>
                <j.processing>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</j.processing>
                <j.tree>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</j.tree>
                <j.util>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</j.util>
                <j.code>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</j.code>
                <j.comp>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</j.comp>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.google.code.findbugs</groupId>
                    <artifactId>jsr305</artifactId>
                    <version>3.0.2</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>enforce-java-version</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireJavaVersion>
                                            <version>[21,)</version>
                                            <message>Error Prone (and therefore NullAway) requires JDK 21 or newer to
                                                run, either build with such a JDK or skip this profile using
                                                -DskipErrorProne
                                            </message>
                                        </requireJavaVersion>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.16.0</version>
                        <executions>
                            <execution>
                                <id>default-compile</id>
                                <configuration>
                                    <fork>true</fork>
                                    <compilerArgs>
                                        <arg>-XDcompilePolicy=simple</arg>
                                        <arg>-Xplugin:ErrorProne ${errorprone.args}</arg>
                                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                                        <arg>-Werror</arg>
                                        <arg>--should-stop=ifError=FLOW</arg>
                                        <arg>${j.api}</arg>
                                        <arg>${j.file}</arg>
                                        <arg>${j.main}</arg>
                                        <arg>${j.model}</arg>
                                        <arg>${j.parser}</arg>
                                        <arg>${j.processing}</arg>
                                        <arg>${j.tree}</arg>
                                        <arg>${j.util}</arg>
                                        <arg>${j.code}</arg>
                                        <arg>${j.comp}</arg>
                                    </compilerArgs>
                                    <annotationProcessorPaths>
                                        <path>
                                            <groupId>com.google.errorprone</groupId>
                                            <artifactId>error_prone_core</artifactId>
                                            <version>2.52.0</version>
                                        </path>
                                        <path>
                                            <groupId>com.uber.nullaway</groupId>
                                            <artifactId>nullaway</artifactId>
                                            <version>0.14.3</version>
                                        </path>
                                    </annotationProcessorPaths>
                                </configuration>
                            </execution>
                            <execution>
                                <id>default-testCompile</id>
                                <configuration>
                                    <fork>true</fork>
                                    <compilerArgs>
                                        <arg>-XDcompilePolicy=simple</arg>
                                        <arg>-Xplugin:ErrorProne ${errorprone.testargs}</arg>
                                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                                        <arg>-Werror</arg>
                                        <arg>--should-stop=ifError=FLOW</arg>
                                        <arg>${j.api}</arg>
                                        <arg>${j.file}</arg>
                                        <arg>${j.main}</arg>
                                        <arg>${j.model}</arg>
                                        <arg>${j.parser}</arg>
                                        <arg>${j.processing}</arg>
                                        <arg>${j.tree}</arg>
                                        <arg>${j.util}</arg>
                                        <arg>${j.code}</arg>
                                        <arg>${j.comp}</arg>
                                    </compilerArgs>
                                    <annotationProcessorPaths>
                                        <path>
                                            <groupId>com.google.errorprone</groupId>
                                            <artifactId>error_prone_core</artifactId>
                                            <version>2.52.0</version>
                                        </path>
                                        <path>
                                            <groupId>com.uber.nullaway</groupId>
                                            <artifactId>nullaway</artifactId>
                                            <version>0.14.3</version>
                                        </path>
                                        <path>
                                            <groupId>org.openjdk.jmh</groupId>
                                            <artifactId>jmh-generator-annprocess</artifactId>
                                            <version>${jmh.version}</version>
                                        </path>
                                    </annotationProcessorPaths>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
